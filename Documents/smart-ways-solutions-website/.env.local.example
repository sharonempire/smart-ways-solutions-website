# ─── Smart Way Solutions — Environment Variables ───────────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# ── Phase 12: Email (Resend) ─────────────────────────────────────────────────
# Get your API key from https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address where loan enquiries should be sent (the company inbox)
COMPANY_EMAIL=loans@smartwaysolutions.com

# Verified sender email on Resend (must match your verified domain)
FROM_EMAIL=enquiries@smartwaysolutions.com

# ── Phase 13: Google Sheets Webhook ──────────────────────────────────────────
# Paste the Apps Script Web App URL here after deploying
# See: scripts/google-apps-script.js for full setup instructions
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ── Phase 19: Analytics ───────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (from analytics.google.com)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel ID (from business.facebook.com → Events Manager)
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXXX

# Site URL (used for sitemap + canonical URLs)
SITE_URL=https://www.smartwaysolutions.in
